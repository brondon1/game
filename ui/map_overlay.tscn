[gd_scene format=3]

[ext_resource type="Script" path="res://ui/map_overlay.gd" id="1_script"]
[ext_resource type="Script" path="res://ui/minimap.gd" id="2_minimap"]

[node name="MapOverlay" type="CanvasLayer"]
process_mode = 3
layer = 8
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.129, 0.078, 0.106, 0.94)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="MapTitle" type="Label" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.98, 0.796, 0.243, 1)
theme_override_font_sizes/font_size = 24
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
text = "地图 · 第 1 层"
horizontal_alignment = 1

[node name="MapPanel" type="PanelContainer" parent="Center/VBox"]
layout_mode = 2
theme_type_variation = &"MapPanel"

[node name="FullMap" type="Control" parent="Center/VBox/MapPanel"]
unique_name_in_owner = true
clip_contents = true
custom_minimum_size = Vector2(420, 180)
layout_mode = 2
mouse_filter = 2
script = ExtResource("2_minimap")
fit_all = true

[node name="Legend" type="RichTextLabel" parent="Center/VBox"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
bbcode_enabled = true
text = "[center][color=#d3bfa9]■[/color] 当前房间　[color=#775c55]■[/color] 去过　[color=#483b3a]■[/color] 未探索　[color=#facb3e]■[/color] 宝箱　[color=#4ba747]■[/color] 商店　[color=#da4e38]■[/color] Boss[/center]"
fit_content = true
scroll_active = false

[node name="Hint" type="Label" parent="Center/VBox"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
text = "Tab / Esc 关闭"
horizontal_alignment = 1
