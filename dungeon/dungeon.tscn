[gd_scene format=3]

[ext_resource type="Script" path="res://dungeon/dungeon.gd" id="1_script"]
[ext_resource type="TileSet" path="res://dungeon/tileset.tres" id="2_tileset"]
[ext_resource type="PackedScene" path="res://player/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="4_hud"]
[ext_resource type="PackedScene" path="res://ui/pause_menu.tscn" id="5_pause"]
[ext_resource type="PackedScene" path="res://ui/buff_select.tscn" id="6_buff"]
[ext_resource type="PackedScene" path="res://ui/game_over.tscn" id="7_game_over"]
[ext_resource type="PackedScene" path="res://ui/map_overlay.tscn" id="8_map"]

[node name="Dungeon" type="Node2D"]
script = ExtResource("1_script")

[node name="TileMapLayer" type="TileMapLayer" parent="." groups=["navigation_source"]]
tile_set = ExtResource("2_tileset")

[node name="Navigation" type="NavigationRegion2D" parent="."]

[node name="Rooms" type="Node2D" parent="."]

[node name="Entities" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Player" parent="Entities" instance=ExtResource("3_player")]

[node name="HUD" parent="." instance=ExtResource("4_hud")]

[node name="PauseMenu" parent="." instance=ExtResource("5_pause")]

[node name="BuffSelect" parent="." instance=ExtResource("6_buff")]

[node name="GameOver" parent="." instance=ExtResource("7_game_over")]

[node name="MapOverlay" parent="." instance=ExtResource("8_map")]
